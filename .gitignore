.DS_Store
node_modules/

# Secretos: .env lleva SECRET_KEY y las claves de la base y del correo.
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Sesiones de Flask-Session en desarrollo (id de usuario y rol dentro).
flask_session/

# Volcados: llevan datos de clientes. db/schema.sql y migrations/ si viajan.
*.dump
*.sql.gz
backups/

logs/
*.log
dump.rdb

# Bases locales sueltas y volcados con nombre propio: datos reales y hashes.
*.db
*.sqlite
*.sqlite3
dumps/
*.sql.zip
*.bak

# Llaves y certificados.
*.pem
*.key
*.p12
*.pfx

# Archivos que sube el usuario (fotos, logos): datos del cliente.
static/uploads/

# Configuracion local de editores y asistentes (rutas del equipo, permisos).
.claude/
.vscode/
.idea/

# Pruebas y empaquetado.
.coverage
htmlcov/
*.egg-info/

Thumbs.db
desktop.ini
