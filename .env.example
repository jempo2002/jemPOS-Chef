# PLANTILLA. Copia este archivo a .env y rellena los valores reales.
# Este archivo SI se sube a git, por eso NUNCA lleva un valor real.

SECRET_KEY=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# redis://host:6379/0. Guarda las sesiones y los contadores de intentos de
# login (y nada mas). Obligatorio en produccion; vacio solo en desarrollo
# (sesiones en disco y contadores en memoria).
REDIS_URL=

# Con 'development' no se fuerza HTTPS ni se exige REDIS_URL. Vacio = produccion.
FLASK_ENV=

# Horas que dura la sesion sin actividad (por defecto 12: un turno largo).
SESSION_HORAS=

# Correo de recuperacion de contrasena (contrasena de aplicacion de Google).
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
LOG_DIR=logs

# Zona horaria del negocio como desfase de UTC (Colombia = -5).
APP_UTC_OFFSET=-5

# Concurrencia (opcionales): workers x hilos de gunicorn; pool MySQL = hilos + 2.
# WEB_CONCURRENCY=4
# GUNICORN_THREADS=4
# DB_POOL_SIZE=6
